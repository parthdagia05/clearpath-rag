# Groq API key — required for LLM calls
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Inference API token — required for embeddings
HF_API_KEY=your_hf_api_token_here

# Optional: embedding model override (default = BAAI/bge-small-en-v1.5)
# For multilingual support set to one of:
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
